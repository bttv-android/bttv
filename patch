#!/bin/bash

if ! cd disass; then
    exit 1
fi

git init

# Cached disassembly trees may have been materialized on Windows with CRLF.
# Patch files are intentionally LF-only, so normalize only their target files
# before creating the index used by git apply --index.
for PatchFile in ../patches/*.patch ../patches/**/*.patch
do
    TargetFile=$(sed -n 's|^--- a/||p' "$PatchFile" | head -n 1)
    [ -n "$TargetFile" ] && [ -f "$TargetFile" ] && sed -i 's/\r$//' "$TargetFile"
done

git add .

if ! cd ../patches; then
    exit 1
fi

for File in *.patch **/*.patch
do
    cd ../disass
    echo $File
    git apply --index ../patches/$File || exit 1
done
